# Copia este archivo a .env y completa los valores. .env nunca se sube a git.

# --- Postgres -----------------------------------------------------------
# Usuario dueño de las dos bases (n8n y radar).
POSTGRES_USER=radar
# Cambia esto por una contraseña larga.
POSTGRES_PASSWORD=cambia-esta-contrasena
# Base interna de n8n (workflows, credenciales, ejecuciones).
N8N_DB_NAME=n8n
# Base del proyecto (sources, profiles, opportunities, matches, runs).
RADAR_DB_NAME=radar
# Puerto local de Postgres (cámbialo si ya tienes otro Postgres en el 5432).
POSTGRES_PORT=5432

# --- n8n ------------------------------------------------------------------
# Clave con la que n8n cifra las credenciales. Genérala una vez y guárdala
# también fuera de este archivo: si se pierde, las credenciales no se recuperan.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
# Puerto local de la interfaz: http://localhost:5678
N8N_PORT=5678

# --- Zona horaria -----------------------------------------------------------
TZ=America/Caracas

# --- Fuentes ------------------------------------------------------------------
# User-Agent identificable que envían los conectores (regla de respeto a fuentes).
SOURCE_USER_AGENT=radar-oportunidades/0.1 (alertas personales de empleo)

# --- Telegram (fase 3) -------------------------------------------------------
# El token del bot se guarda como credencial de n8n, no aquí.
