    {
      "parameters": {
        "jsCode": "const { parseGetOnBoard, normalizeAll } = require('/opt/radar/lib/index.js');\n\nconst source = $('When Executed by Another Workflow').first().json;\nconst response = $input.first().json;\n\ntry {\n  if (response.error) {\n    throw new Error(response.error.message ?? JSON.stringify(response.error));\n  }\n  const candidates = parseGetOnBoard(response.body);\n  const opportunities = normalizeAll(candidates, source.id);\n  return [{ json: {\n    source_id: source.id,\n    fetched: candidates.length,\n    normalized: opportunities.length,\n    error: null,\n    opportunities,\n  } }];\n} catch (err) {\n  return [{ json: {\n    source_id: source.id, fetched: 0, normalized: 0, error: err.message, opportunities: [],\n  } }];\n}"
      },
