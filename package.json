{
  "name": "radar-oportunidades",
  "version": "0.1.0",
  "private": true,
  "description": "Motor en n8n que recolecta, filtra y puntúa oportunidades remotas y envía un resumen diario.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db:migrate": "docker compose run --rm migrate",
    "db:psql": "docker compose exec postgres sh -c \"psql -U $POSTGRES_USER -d $RADAR_DB_NAME\"",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs"
  }
}
